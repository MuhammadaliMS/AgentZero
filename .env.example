# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Token Encryption
TOKEN_ENCRYPTION_SECRET=your-32-byte-hex-secret

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook + Calendar + Teams)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Vanta
VANTA_CLIENT_ID=
VANTA_CLIENT_SECRET=

# CrowdStrike
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=

# Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Qualys
QUALYS_API_URL=

# ─── NVIDIA NIM (primary LLM provider) ───────────────
# Qwen 3.5 397B via NVIDIA NIM — used for all agents + extraction
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=

# ─── OpenRouter (fallback + embeddings) ──────────────
# Used as fallback if NVIDIA_API_KEY is not set, and always for embeddings
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override LLM model (default: moonshotai/kimi-k2.5 when NVIDIA, minimax/minimax-m2.5 when OpenRouter)
# EXTRACTOR_MODEL=moonshotai/kimi-k2.5
# Optional: override embedding model (default: openai/text-embedding-3-small via OpenRouter)
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: override embedding provider (default: OpenRouter — must produce 1536-dim vectors)
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Optional: override LLM base URL
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Chief Loop — hourly intelligence analyst model
# Default: moonshotai/kimi-k2.5 via NVIDIA NIM (deep reasoning, high token budget)
# Fallback: minimax/minimax-m2.5 via OpenRouter
# CHIEF_ANALYST_MODEL=moonshotai/kimi-k2.5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for securing cron job endpoints)
CRON_SECRET=your-cron-secret
