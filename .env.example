# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Token Encryption
TOKEN_ENCRYPTION_SECRET=your-32-byte-hex-secret

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook + Calendar + Teams)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Vanta
VANTA_CLIENT_ID=
VANTA_CLIENT_SECRET=

# CrowdStrike
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=

# Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Qualys
QUALYS_API_URL=

# OpenRouter (for graph memory extraction + embeddings)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override extraction model (default: openai/gpt-4o-mini)
# EXTRACTOR_MODEL=openai/gpt-4o-mini
# Optional: override embedding model (default: openai/text-embedding-3-small)
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: override base URL (default: https://openrouter.ai/api/v1)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Chief Loop — hourly intelligence analyst model
# Uses OpenRouter. Default: minimax/minimax-m2.5 (deep reasoning, high token budget)
# Other options: x-ai/grok-4.1-fast, anthropic/claude-sonnet-4, openai/gpt-4o
# CHIEF_ANALYST_MODEL=minimax/minimax-m2.5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for securing cron job endpoints)
CRON_SECRET=your-cron-secret
